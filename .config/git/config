# vim: set filetype=gitconfig:

[core]
  editor = nano
  autocrlf = input
  excludesFile = ~/.config/git/ignore

[diff]
  tool = vimdiff

[credential]
	helper = manager

[safe]
  directory = *

[gpg]
  format = ssh

[commit]
  gpgSign = true

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[tag]
  gpgSign = true

[init]
  defaultBranch = master

[alias]
  timeline = log --graph --abbrev-commit --decorate --format=format:'%C(green)(%ad)%C(reset) %C(bold blue)%h%C(reset)%C(auto)%d%C(reset) %s%C(reset) %C(dim white)- %an%C(reset)' --all --date='format:%d/%m %R'
  df = diff --cached
  cm = commit -m
  ca = commit --amend
  s = status
  d = diff
  dc = diff --cached
  l = log
  zip = archive --format=zip --output archive.zip

[pull]
  autoStash = true
  rebase = true

[include]
  path = ~/.config/git/profiles/config
